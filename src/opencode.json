{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "enabled_providers": [
    "openai"
  ],
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.1,
            "cache_write": 2.5
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            }
          }
        }
      }
    }
  }
}
